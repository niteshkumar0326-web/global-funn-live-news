# Copy to .env.local after creating/selecting the Supabase project.
# Use the Project URL and Publishable key from Supabase > Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Do not add SUPABASE_SECRET_KEY or service_role keys to NEXT_PUBLIC variables.

# Optional local AI (disabled by default). Requires Ollama on this same machine.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
